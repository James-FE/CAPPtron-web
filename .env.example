# Frontend-only variables are visible in the shipped browser bundle.
# Never put secrets, SSH credentials, or Mastercam credentials here.
VITE_API_BASE_URL=http://127.0.0.1:8000

# 仅本机 development 模式读取单一 Golden-B7 文件；写入忽略的 .env.development.local。
# 使用绝对路径；不要使用 VITE_ 前缀。文件必须匹配已发布案例的原始字节摘要。
# CAPPTRON_GOLDEN_B7_NC=
