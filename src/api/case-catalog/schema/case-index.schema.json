{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cases"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "name",
          "description",
          "partType",
          "sourceCategory",
          "tags",
          "versions"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-._][a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "partType": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sourceCategory": {
            "const": "engineering_reference"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "path", "contentDigest"],
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[-._][a-z0-9]+)*$"
                },
                "path": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9._-]*\\.json$"
                },
                "contentDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 0
    }
  }
}
